{
  "name": "playce",
  "private": true,
  "version": "0.1.0",
  "description": "Playce — müziği çal, mekânı bul (Expo mobil + NestJS API)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @playce/api dev",
    "dev:worker": "pnpm --filter @playce/api dev:worker",
    "dev:mobile": "pnpm --filter @playce/mobile start",
    "ios": "pnpm --filter @playce/mobile ios",
    "db:create": "createdb playce_dev || true",
    "db:migrate": "pnpm --filter @playce/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @playce/api db:seed",
    "db:seed:base": "pnpm --filter @playce/api db:seed:base",
    "db:studio": "pnpm --filter @playce/api prisma:studio",
    "typecheck": "pnpm -r typecheck",
    "test:api": "pnpm --filter @playce/api test:e2e"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.5.0",
      "qs": "^6.17.0",
      "js-yaml@5": "^5.4.1"
    }
  }
}
