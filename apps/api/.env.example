# Yerel Postgres (Homebrew). Docker kullanıyorsan kullanıcı/şifreyi ona göre değiştir.
DATABASE_URL=postgresql://emre@localhost:5432/playce_dev
PORT=3030
# /admin/* uçları için X-Admin-Key başlığı. Prod'da uzun rastgele bir değer kullan.
ADMIN_KEY=change-me
NODE_ENV=development
# Access token imzası (HS256), en az 32 karakter: openssl rand -base64 48
JWT_SECRET=
# E-posta OTP gönderimi, ör. smtp://kullanici:sifre@smtp.ornek.com:587
# Boşsa geliştirmede kod API konsoluna yazılır; production'da zorunlu.
SMTP_URL=
MAIL_FROM=Playce <no-reply@playce.app>
# Apple girişi: identity token "aud" değerleri (virgülle). Expo Go için host.exp.Exponent eklenir.
APPLE_AUDIENCES=app.playce.mobile
# Google girişi: OAuth istemci kimlikleri (iOS, Android, web — virgülle). Boşsa Google girişi kapalı.
GOOGLE_CLIENT_IDS=
# Expo push "enhanced security" açıksa gerekli
EXPO_ACCESS_TOKEN=
