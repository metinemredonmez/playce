// Playce veri modeli.
// Eksen: Genre (müzik türü) — radyo istasyonlarını, etkinlikleri, mekânları ve sanatçıları birbirine bağlar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// DRAFT → REVIEW (moderasyon bekliyor) → PUBLISHED → CANCELLED. Uygulamada yalnız PUBLISHED (ve iptal bilgisi için CANCELLED) görünür.
enum EventStatus {
  DRAFT
  REVIEW
  PUBLISHED
  CANCELLED
}

/// Dış kaynaklar: bilet satıcısı, içe aktarma, kimlik eşleme.
enum ExternalSource {
  BILETIX
  PASSO
  BUBILET
  BILETINIAL
  MOBILET
  ETKINLIKIO
  TICKETMASTER
  BANDSINTOWN
  MUSICBRAINZ
  SPOTIFY
  APPLE_MUSIC
  GOOGLE_PLACES
  INSTAGRAM
}

/// Saatlik sağlık işi belirler. DOWN uygulamada görünmez; NO_METADATA çalar ama "şu an çalan" yoktur.
enum StationStatus {
  OK
  DOWN
  NO_METADATA
}

/// Verinin nereden geldiği. DEMO kayıtlar uygulamada "DEMO" rozetiyle gösterilir.
enum DataSource {
  DEMO
  ADMIN
  IMPORT
}

model Genre {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  color    String
  /// radio-browser.info araması için tag (ör. "deep house")
  radioTag String
  sort     Int    @default(0)

  stations Station[]
  events   Event[]
  venues   Venue[]
  artists  Artist[]
  /// Kullanıcının seçtiği zevk türleri
  tasteOf  User[]        @relation("UserTaste")
  tags     TagGenreMap[]
}

/// Dış etiket → Playce türü ("afro house" → Deep House 0.7 + Techno 0.3). Last.fm, Spotify, radio-browser etiketleri için.
model TagGenreMap {
  /// normalize("Afro House") = "afro house"
  tag     String
  genreId String
  weight  Float  @default(1)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([tag, genreId])
}

model Station {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  streamUrl   String
  homepage    String?
  logoUrl     String?
  country     String?
  /// Yayın ICY "şu an çalan" bilgisi veriyor mu (HLS yayınlar vermez)
  hasMetadata Boolean @default(true)
  sort        Int     @default(0)

  status        StationStatus @default(OK)
  lastCheckedAt DateTime?
  /// Ardışık başarısız kontrol; 3 olunca DOWN
  failCount     Int           @default(0)
  lastError     String?
  /// "audio/mpeg", "audio/aacp", "hls"
  codec         String?
  bitrate       Int?

  /// Arama için normalize edilmiş ad — DB tetikleyicisi doldurur, uygulama yazmaz
  searchText String @default("")

  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  plays     PlayLog[]
  favoredBy FavoriteStation[]

  createdAt DateTime @default(now())

  @@index([genreId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Venue {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  district    String
  address     String?
  lat         Float?
  lng         Float?
  description String?
  coverUrl    String?
  instagram   String?
  /// 1-4 arası fiyat seviyesi (₺ … ₺₺₺₺)
  priceLevel  Int?
  source      DataSource @default(ADMIN)
  /// 18 = gece kulübü; etkinlikte ageLimit yoksa bu geçerli (ADR-015)
  ageLimit    Int?
  /// Güven alanları (M17): "Seçici kapı, kimlik zorunlu" / "Spor ayakkabı kabul"
  doorPolicy  String?
  dressCode   String?
  /// ad + semt, normalize — DB tetikleyicisi doldurur
  searchText  String     @default("")

  genres  Genre[]
  events  Event[]
  follows VenueFollow[]
  hours   VenueHours[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Haftalık çalışma saati, gün başına bir aralık. Kapanış açılıştan küçük/eşitse ertesi güne taşar ("23:00"–"05:00").
model VenueHours {
  venueId  String
  /// 0 = Pazar … 6 = Cumartesi
  weekday  Int
  /// "HH:MM", İstanbul saati
  opensAt  String
  closesAt String
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([venueId, weekday])
}

model Artist {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  /// ICY başlığında farklı yazılışlar (ör. "Duman" / "DUMAN")
  aliases    String[] @default([])
  imageUrl   String?
  bio        String?
  /// ad + alias'lar, normalize — DB tetikleyicisi doldurur
  searchText String   @default("")

  genres    Genre[]
  events    EventArtist[]
  follows   ArtistFollow[]
  plays     PlayLog[]
  unmatched UnmatchedArtist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Event {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  description    String?
  coverUrl       String?
  startsAt       DateTime
  endsAt         DateTime?
  /// Para = minor unit (kuruş). 450 TL = 45000.
  priceFrom      Int?
  currency       String          @default("TRY")
  /// Ücretsiz giriş (priceFrom = 0 girilirse kendiliğinden true)
  isFree         Boolean         @default(false)
  /// 18 = gece hayatı; 18 yaş altına gösterilmez (ADR-015)
  ageLimit       Int?
  doorsAt        DateTime?
  ticketUrl      String?
  /// Bilet linkinin satıcısı ("Biletix'ten al"); boşsa ticketUrl'den çıkarılır
  ticketProvider ExternalSource?
  /// Güven alanları (M17): satıcı/organizatör, toplam fiyat notu ("Hizmet bedeli dahil"), iade koşulu
  sellerName     String?
  totalPriceNote String?
  refundPolicy   String?
  status         EventStatus     @default(PUBLISHED)
  source         DataSource      @default(ADMIN)
  /// başlık, normalize — DB tetikleyicisi doldurur
  searchText     String          @default("")

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  genres  Genre[]
  artists EventArtist[]
  saves   SavedEvent[]

  /// Takipçilere "yeni etkinlik" bildirimi üretildiği an. Null + PUBLISHED = worker gönderecek.
  fanoutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([venueId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Lineup — sort küçük olan headliner.
model EventArtist {
  eventId  String
  artistId String
  sort     Int    @default(0)

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([eventId, artistId])
  @@index([artistId])
}

// ---------- Kullanıcı & kimlik ----------

enum Role {
  USER
  EDITOR
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  EMAIL
  APPLE
  GOOGLE
}

enum ConsentKind {
  KVKK_AYDINLATMA
  ACIK_RIZA_PAZARLAMA
  ANALYTICS
  LOCATION
  MUSIC_PROFILE
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  avatarUrl String?
  role      Role      @default(USER)
  city      String    @default("istanbul")
  locale    String    @default("tr")
  /// 18+ içerik için yalnız yıl (veri minimizasyonu)
  birthYear Int?
  bannedAt  DateTime?
  /// KVKK silme talebi. 30 gün içinde giriş yaparsa hesap geri gelir; sonra anonimleştirilir.
  deletedAt DateTime?
  /// Anonimleştirme yapıldı (kişisel alanlar silindi)
  purgedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  identities       AuthIdentity[]
  sessions         Session[]
  consents         Consent[]
  tasteGenres      Genre[]           @relation("UserTaste")
  artistFollows    ArtistFollow[]
  venueFollows     VenueFollow[]
  saves            SavedEvent[]
  favStations      FavoriteStation[]
  pushTokens       PushToken[]
  notifications    Notification[]
  notificationPref NotificationPref?
}

model AuthIdentity {
  id        String       @id @default(cuid())
  userId    String
  provider  AuthProvider
  /// Apple sub / Google sub / e-posta
  subject   String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// Bir cihazdaki oturum. Refresh token her kullanımda döner; düz token saklanmaz.
model Session {
  id          String    @id @default(cuid())
  userId      String
  /// sha256(geçerli refresh token)
  refreshHash String    @unique
  /// sha256(bir önceki refresh token) — yeniden kullanılırsa token çalınmış sayılır
  prevHash    String?   @unique
  userAgent   String?
  expiresAt   DateTime
  rotatedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  /// HMAC(e-posta:kod) — düz kod saklanmaz
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// Her onay değişikliği yeni satır (ispat için). Geçerli durum = türün en son satırı.
model Consent {
  id        String      @id @default(cuid())
  userId    String
  kind      ConsentKind
  /// Metin sürümü, ör. "2026-11-01"
  version   String
  granted   Boolean
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

// ---------- Sosyal ----------

enum SaveStatus {
  INTERESTED
  GOING
}

model ArtistFollow {
  userId        String
  artistId      String
  /// "Radyoda çaldığında haber ver"
  notifyOnRadio Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist        Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([artistId])
}

model VenueFollow {
  userId    String
  venueId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@index([venueId])
}

model SavedEvent {
  userId     String
  eventId    String
  status     SaveStatus @default(INTERESTED)
  remindedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

/// radio-browser istasyonları DB'de olmayabilir → URL + ad da saklanır.
model FavoriteStation {
  id          String   @id @default(cuid())
  userId      String
  stationId   String?
  streamUrl   String
  name        String
  genreSlug   String?
  logoUrl     String?
  hasMetadata Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  station     Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@unique([userId, streamUrl])
}

// ---------- Bildirim ----------

enum NotificationKind {
  ARTIST_NEW_EVENT
  ARTIST_ON_RADIO
  EVENT_REMINDER
  VENUE_NEW_EVENT
  WEEKLY_DIGEST
  CAMPAIGN
  SYSTEM
}

/// Push gönderimi bildirim satırının kendisinden yürür (DB outbox, ADR-020).
enum PushState {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model PushToken {
  id         String   @id @default(cuid())
  /// Girişsiz cihazlar da kayıt olabilir (kampanya için)
  userId     String?
  deviceId   String
  /// ExponentPushToken[…]
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  /// playce://event/slug
  deeplink  String?
  data      Json?
  /// Aynı bildirimi iki kez üretmemek için: "event:<eventId>:<userId>", "radio:<userId>:<gün>"
  dedupeKey String?          @unique
  readAt    DateTime?
  pushState PushState        @default(PENDING)
  /// Sessiz saatlerde ertelenir
  pushAfter DateTime         @default(now())
  pushedAt  DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pushState, pushAfter])
}

model NotificationPref {
  userId         String  @id
  artistNewEvent Boolean @default(true)
  venueNewEvent  Boolean @default(true)
  artistOnRadio  Boolean @default(true)
  eventReminder  Boolean @default(true)
  weeklyDigest   Boolean @default(true)
  /// Açık rıza (ACIK_RIZA_PAZARLAMA) olmadan açılamaz
  marketing      Boolean @default(false)
  /// İstanbul saatiyle; bu aralıkta push gönderilmez (başlangıç = bitiş → kapalı)
  quietStart     Int     @default(1)
  quietEnd       Int     @default(10)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Expo gönderim makbuzu; 15 dk sonra kontrol edilir (DeviceNotRegistered → token silinir).
model PushTicket {
  id             String   @id
  token          String
  notificationId String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ---------- Radyo istatistiği ----------

model PlayLog {
  id        BigInt   @id @default(autoincrement())
  stationId String
  raw       String
  artistRaw String?
  /// normalize(artistRaw) — eşleşmeyenler kuyruğundan bağlanınca geriye dönük doldurmak için
  artistKey String?
  title     String?
  artistId  String?
  at        DateTime @default(now())
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([artistId, at])
  @@index([stationId, at])
  @@index([artistKey])
  /// /health/deep son kayıt, gece temizliği 90 gün
  @@index([at])
}

enum UnmatchedStatus {
  OPEN
  IGNORED
  LINKED
}

/// Radyoda çalan ama DB'de olmayan sanatçılar — admin "Eşleşmeyenler" kuyruğu.
model UnmatchedArtist {
  /// normalize("Oğuzhan Koç") = "oguzhan koc"
  key        String          @id
  display    String
  plays      Int             @default(1)
  sampleRaw  String
  lastSeenAt DateTime        @default(now())
  status     UnmatchedStatus @default(OPEN)
  artistId   String?
  artist     Artist?         @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([status, plays])
}

// ---------- Operasyon ----------

/// Kaydın dış kaynaktaki karşılığı: içe aktarmada aynı etkinlik/mekân ikinci kez açılmaz.
model ExternalRef {
  id         String         @id @default(cuid())
  /// event | venue | artist
  entityType String
  entityId   String
  source     ExternalSource
  externalId String
  url        String?
  syncedAt   DateTime       @default(now())

  @@unique([source, entityType, externalId])
  @@index([entityType, entityId])
}

/// İçe aktarma turu (gece işi ya da admin). Sayılar ve ilk hatalar admin'de görünür.
model ImportRun {
  id         String         @id @default(cuid())
  source     ExternalSource
  dryRun     Boolean        @default(false)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  fetched    Int            @default(0)
  created    Int            @default(0)
  updated    Int            @default(0)
  /// Aynı etkinlik zaten vardı (başka kaynak/admin) → yalnız ExternalRef eklendi
  merged     Int            @default(0)
  skipped    Int            @default(0)
  errors     Json?

  @@index([source, startedAt])
}

/// Admin yazmalarının kaydı. actorId FK değil: kullanıcı silinse de kayıt kalır; X-Admin-Key için "admin-key".
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  /// event.create, venue.update, unmatched.link …
  action     String
  entityType String
  entityId   String
  /// İstekte gönderilen alanlar (PATCH'te değişenler)
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
